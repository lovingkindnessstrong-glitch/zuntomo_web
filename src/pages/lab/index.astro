---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const labEntries = await getCollection('lab');

// =========================================================
// 【USAGE】複数ステージの名寄せ（グループ化）機能
// =========================================================
const groupedEvents = labEntries.reduce((acc, entry) => {
  const eventName = entry.data.event_name;
  if (!acc[eventName]) {
    acc[eventName] = [];
  }
  acc[eventName].push(entry);
  return acc;
}, {} as Record<string, any[]>);

const groupedEventsArray = Object.entries(groupedEvents).map(([eventName, entries]) => {
  const sortedEntries = entries.sort((a, b) => {
    const timeA = `${a.data.performance_date} ${a.data.performance_time}`;
    const timeB = `${b.data.performance_date} ${b.data.performance_time}`;
    return timeA.localeCompare(timeB);
  });
  
  return {
    eventName,
    entries: sortedEntries,
    mainDate: sortedEntries[0].data.date.valueOf() // 比較用のタイムスタンプ
  };
}).sort((a, b) => b.mainDate - a.mainDate);

// =========================================================
// 【NEW】今日の日付を基準に「今後のイベント」と「過去のイベント」に分割
// =========================================================
const today = new Date();
today.setHours(0, 0, 0, 0); // 時間をリセットして日付のみで正確に比較できるようにする

const upcomingEvents = groupedEventsArray.filter(group => {
  const eventDate = new Date(group.mainDate);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate >= today; // 今日以降
}).reverse(); // 今後のイベントは「直近のものが上」に来るように反転

const pastEvents = groupedEventsArray.filter(group => {
  const eventDate = new Date(group.mainDate);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate < today; // 昨日以前
});
---

<Layout title="S-Dance Lab（自習用香盤表） | ズンとも">
  <main class="container mx-auto px-4 py-8 max-w-3xl">
    <div class="mb-8 border-b pb-4">
      <h1 class="text-3xl font-bold text-gray-800">S-Dance Lab😺ズンともイベント練習用動画😺</h1>
      <p class="text-gray-600 mt-2">練習用の動画と、本番注意事項です。出演者は必ず目を通してください。</p>
    </div>

    {/* =========================================
        今後のイベント（デフォルトで展開）
    ========================================= */}
    {upcomingEvents.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xl font-bold text-blue-600 border-b-2 border-blue-200 pb-2 mb-6">📅 今後のイベント</h2>
        <div class="space-y-6">
          {upcomingEvents.map((group) => (
            <details class="group border border-gray-200 rounded-xl bg-white shadow-sm [&_summary::-webkit-details-marker]:hidden" open>
              
              <summary class="flex justify-between items-center bg-blue-50/30 px-5 py-4 text-gray-800 cursor-pointer hover:bg-blue-50/60 transition rounded-t-xl group-open:border-b group-open:border-gray-200">
                <h3 class="text-xl font-bold">{group.eventName}</h3>
                <span class="text-blue-500 transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              
              <div class="overflow-hidden">
                <ul class="divide-y divide-gray-100">
                  {group.entries.map(entry => (
                    <li>
                      <a href={`/lab/${entry.id}`} class="block hover:bg-blue-50/50 p-5 transition group/link">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                          <div class="flex flex-col gap-1">
                            <span class="text-blue-600 font-bold text-lg group-hover/link:underline">
                              {entry.data.program_name}
                            </span>
                            <div class="text-sm text-gray-500 flex flex-wrap gap-x-4 gap-y-1">
                              <span>📅 {entry.data.performance_date} {entry.data.performance_time}</span>
                              <span>📍 {entry.data.venue}</span>
                            </div>
                          </div>
                          <div class="text-gray-400 hidden md:block">
                            <svg class="w-5 h-5 group-hover/link:text-blue-600 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                          </div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </div>
      </div>
    )}

    {/* =========================================
        過去のイベント（デフォルトで折りたたみ）
    ========================================= */}
    {pastEvents.length > 0 && (
      <div>
        <h2 class="text-xl font-bold text-gray-500 border-b-2 border-gray-200 pb-2 mb-6">📁 過去のイベント</h2>
        <div class="space-y-4">
          {pastEvents.map((group) => (
            <details class="group border border-gray-200 rounded-xl bg-white shadow-sm [&_summary::-webkit-details-marker]:hidden">
              
              <summary class="flex justify-between items-center bg-gray-50 px-5 py-3 text-gray-600 cursor-pointer hover:bg-gray-100 transition rounded-t-xl group-open:border-b group-open:border-gray-200">
                <h3 class="text-lg font-bold">{group.eventName}</h3>
                <span class="text-gray-400 transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              
              <div class="overflow-hidden">
                <ul class="divide-y divide-gray-100 bg-gray-50/50">
                  {group.entries.map(entry => (
                    <li>
                      <a href={`/lab/${entry.id}`} class="block hover:bg-gray-100 p-4 transition group/link opacity-80 hover:opacity-100">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                          <div class="flex flex-col gap-1">
                            <span class="text-gray-700 font-bold group-hover/link:underline">
                              {entry.data.program_name}
                            </span>
                            <div class="text-xs text-gray-500 flex flex-wrap gap-x-4 gap-y-1">
                              <span>📅 {entry.data.performance_date}</span>
                              <span>📍 {entry.data.venue}</span>
                            </div>
                          </div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </div>
      </div>
    )}
  </main>
</Layout>