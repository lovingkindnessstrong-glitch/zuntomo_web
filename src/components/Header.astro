---
import logoImage from '../assets/images/common/logo.svg';
// 💡 JSONデータをインポート（パスは実際の構成に合わせて調整してください）
import scheduleData from '../data/schedule.json';
import { getCollection } from 'astro:content';

// ==========================================
// 💡 更新バッジ（NEWマーク）の判定ロジック
// ==========================================
const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;
const now = new Date().valueOf();

// ① スケジュールの判定
const parsedScheduleDate = scheduleData.last_updated.replace(/年|月/g, '/').replace('日', '');
const isScheduleUpdated = (now - new Date(parsedScheduleDate).valueOf()) < SEVEN_DAYS;

// ② BLOGの判定（getCollection ではなく glob を使用）
const allBlogs = Object.values(import.meta.glob('../pages/blog/**/*.md', { eager: true })) as any[];
const latestBlog = allBlogs.sort((a, b) => {
  const dateA = a.frontmatter?.date ? new Date(a.frontmatter.date).valueOf() : 0;
  const dateB = b.frontmatter?.date ? new Date(b.frontmatter.date).valueOf() : 0;
  return dateB - dateA;
})[0];
const isBlogUpdated = latestBlog?.frontmatter?.date 
  ? (now - new Date(latestBlog.frontmatter.date).valueOf()) < SEVEN_DAYS 
  : false;

// ③ LABの判定（こちらは Content Collections）
let isLabUpdated = false;
try {
  const allLabs = await getCollection('lab');
  const latestLab = allLabs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
  if (latestLab) {
    isLabUpdated = (now - new Date(latestLab.data.date).valueOf()) < SEVEN_DAYS;
  }
} catch (error) {
  // まだ記事がない場合のエラーを回避
}
// ==========================================

const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/about/', label: 'ABOUT' },
  { href: '/guide/', label: 'GUIDE' },
  {
    href: '/#lesson',
    label: 'LESSON',
    children: [
      { href: '/activities/standard/', label: '大人クラス' },
      { href: '/activities/kids/', label: 'キッズクラス' },
      { href: '/activities/gold/', label: 'ゴールドクラス' },
      { href: '/activities/salsa/', label: 'サルサ・バチャータ' },
      { href: '/activities/neko-odori/', label: '猫おどり部' },
    ],
  },
  { href: '/blog/', label: 'BLOG', isUpdated: isBlogUpdated },
  { href: '/lab/', label: 'LAB', isUpdated: isLabUpdated },
];

const LINE_URL = 'https://lin.ee/8Rjc7Jd';
const currentPath = Astro.url.pathname;

const isCurrent = (href: string, children?: {href: string, label: string}[]) => {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) {
    if (children) return children.some(child => currentPath.startsWith(child.href));
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 bg-white/95 shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-3 py-1 md:px-6">
    
    {/* ロゴ部分 */}
    <a href="/" class="flex shrink-0 items-center transition-opacity hover:opacity-80 pr-2" aria-label="ズンともホーム">
      <img src={logoImage.src} alt="沼津・三島のダンスサークル ズンとも" class="h-14 md:h-20 w-auto" />
    </a>

    {/* PC版 グローバルナビゲーション */}
    <nav class="hidden md:flex md:items-center md:gap-8" aria-label="Primary navigation">
      {navLinks.map((link) => {
        const isActive = isCurrent(link.href, link.children);
        return link.children ? (
          <div class="relative group py-4">
            <a href={link.href} class={`text-sm font-bold transition flex items-center gap-1 ${isActive ? 'text-emerald-600' : 'text-slate-700 hover:text-slate-900'}`}>
              {link.label}
              <svg class={`h-4 w-4 transition-transform duration-200 group-hover:rotate-180 ${isActive ? 'text-emerald-600' : 'text-slate-400 group-hover:text-slate-600'}`} viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <div class="absolute left-1/2 -translate-x-1/2 top-full z-50 w-48 rounded-xl bg-white py-2 shadow-xl ring-1 ring-black/5 transition-all duration-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible">
              {link.children.map((child) => {
                const isChildActive = currentPath.startsWith(child.href);
                return (
                  <a href={child.href} class={`block px-4 py-2.5 text-sm transition hover:bg-slate-50 ${isChildActive ? 'text-emerald-600 font-bold bg-slate-50' : 'text-slate-600 hover:text-slate-900'}`}>
                    {child.label}
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <a href={link.href} class={`relative text-sm font-bold transition py-4 ${isActive ? 'text-emerald-600' : 'text-slate-700 hover:text-slate-900'}`}>
            {link.label}
            {/* 更新バッジ（PC用） */}
            {link.isUpdated && (
              <span class="absolute top-3 -right-2 flex h-2 w-2 rounded-full bg-red-500"></span>
            )}
          </a>
        );
      })}
    </nav>

    {/* 右側アクションエリア（スマホ用ショートカット含む） */}
    <div class="flex items-center gap-2 sm:gap-3">
      
      {/* 💡 スマホ専用ショートカット（BLOG / LAB）※ハンバーガーから外に出しました */}
      <div class="flex items-center gap-3 md:hidden">
        <a href="/blog" class="relative text-[11px] font-bold text-slate-600 hover:text-emerald-600 transition">
          BLOG
          {isBlogUpdated && <span class="absolute -top-1 -right-1.5 h-1.5 w-1.5 rounded-full bg-red-500"></span>}
        </a>
        <a href="/lab" class="relative text-[11px] font-bold text-slate-600 hover:text-emerald-600 transition">
          LAB
          {isLabUpdated && <span class="absolute -top-1 -right-1.5 h-1.5 w-1.5 rounded-full bg-red-500"></span>}
        </a>
      </div>

      <!-- スケジュールボタン（NEWバッジ付き） -->
      <a href="/schedule" class="relative flex items-center gap-1 px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold transition-colors">
        {/* スケジュールのバッジは少し目立たせる（波紋エフェクト） */}
        {isScheduleUpdated && (
          <span class="absolute -top-1 -right-1 flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
          </span>
        )}
        <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="text-[11px] sm:text-sm">予定</span>
      </a>
      
      {/* PC版・スマホ共通 LINEアイコンボタン（スマホではアイコンのみで省スペース化） */}
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[#06C755] p-1.5 md:px-5 md:py-2 text-sm font-semibold text-white transition hover:bg-emerald-500"
      >
        <svg class="h-5 w-5 md:hidden" viewBox="0 0 24 24" fill="currentColor" aria-label="LINE申込">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
        </svg>
        <span class="hidden md:inline">LINEで体験申込</span>
      </a>

      {/* ハンバーガーメニューボタン */}
      <button
        id="header-menu-button"
        type="button"
        aria-label="メニューを開閉"
        aria-expanded="false"
        class="inline-flex h-9 w-9 md:h-10 md:w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-slate-50 md:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* モバイルメニュー */}
  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white/95 px-4 pb-4 md:hidden" aria-label="Mobile navigation">
    <div class="flex flex-col gap-2 pt-3">
      {navLinks.map((link) => {
        const isActive = isCurrent(link.href, link.children);
        return link.children ? (
          <div>
            <a href={link.href} class={`block rounded-2xl px-4 py-3 text-sm font-bold transition ${isActive ? 'bg-emerald-50 text-emerald-700' : 'text-slate-800 hover:bg-slate-100'}`}>
              {link.label}
            </a>
            <div class="ml-4 flex flex-col gap-1 border-l-2 border-slate-100 pl-4 py-1">
              {link.children.map((child) => {
                const isChildActive = currentPath.startsWith(child.href);
                return (
                  <a href={child.href} class={`rounded-xl px-4 py-2 text-sm transition ${isChildActive ? 'bg-emerald-50 text-emerald-700 font-bold' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}`}>
                    {child.label}
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <a href={link.href} class={`flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-bold transition ${isActive ? 'bg-emerald-50 text-emerald-700' : 'text-slate-700 hover:bg-slate-100'}`}>
            {link.label}
            {link.isUpdated && <span class="text-xs bg-red-500 text-white px-2 py-0.5 rounded-full">NEW</span>}
          </a>
        );
      })}
    </div>
  </nav>

  <script>
    const button = document.getElementById('header-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (button && mobileMenu) {
      button.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('hidden');
        button.setAttribute('aria-expanded', String(!isOpen));
      });
    }
  </script>
</header>